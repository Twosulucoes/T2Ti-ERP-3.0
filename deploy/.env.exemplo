# Copie este arquivo para .env e troque TODOS os valores antes de subir.

# Domínio apontado para o IP do servidor (o Caddy emite o certificado HTTPS sozinho).
# Para testar sem domínio, use: DOMINIO=http://IP_DO_SERVIDOR
DOMINIO=erp.suaempresa.com.br

# Senhas do MySQL
MYSQL_ROOT_PASSWORD=troque-esta-senha-root
MYSQL_USER=erp
MYSQL_PASSWORD=troque-esta-senha-do-erp

# Primeiro usuário do sistema (criado só na primeira subida do banco)
ADMIN_LOGIN=admin
ADMIN_SENHA=troque-esta-senha-do-admin

# Criptografia do login e assinatura do token (JWT).
# A chave precisa ter EXATAMENTE 32 caracteres e o vetor EXATAMENTE 16.
# Gere com: openssl rand -hex 16   (chave)   e   openssl rand -hex 8   (vetor)
CHAVE_CRIPTOGRAFIA=00000000000000000000000000000000
VETOR_CRIPTOGRAFIA=0000000000000000
